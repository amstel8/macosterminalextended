#!/bin/sh
set -eu
target_volume="${3:-/}"
# A package installed to another volume will initialize on its first manual launch.
[ "$target_volume" = "/" ] || exit 0
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$console_user" in root|loginwindow|_mbsetupuser|'') exit 0 ;; esac
console_uid=$(/usr/bin/id -u "$console_user")
user_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')
[ -d "$user_home" ] || exit 0
agents_dir="$user_home/Library/LaunchAgents"
/usr/bin/sudo -u "$console_user" /bin/mkdir -p "$agents_dir"
agent="$agents_dir/dev.local.ExtendedTerminal.plist"
/usr/bin/sudo -u "$console_user" /usr/bin/tee "$agent" > /dev/null <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.local.ExtendedTerminal</string>
<key>ProgramArguments</key><array>
<string>/Library/Application Support/Extended Terminal/Extended Terminal.app/Contents/MacOS/TerminalCopyOnSelect</string>
<string>--background</string>
</array>
<key>RunAtLoad</key><true/>
</dict></plist>
PLIST
/usr/bin/sudo -u "$console_user" /bin/chmod 644 "$agent"
# Launch as the logged-in user; never request Accessibility as root.
shell_rc="$user_home/.zshrc"
/usr/bin/sudo -u "$console_user" /bin/sh -s -- "$shell_rc" <<'SHELL_SETUP'
rc_path=$1
if ! /usr/bin/grep -Fq '# BEGIN Extended Terminal' "$rc_path" 2>/dev/null; then
    if [ -f "$rc_path" ]; then
        /bin/cp -p "$rc_path" "$rc_path.extended-terminal-backup-$(/bin/date +%Y%m%d%H%M%S)"
    fi
    /bin/cat >> "$rc_path" <<'ZSH_BLOCK'

# BEGIN Extended Terminal
if [[ $TERM_PROGRAM == Apple_Terminal && -r '/Library/Application Support/Extended Terminal/Extended Terminal.app/Contents/Resources/extended-terminal.zsh' ]]; then
    source '/Library/Application Support/Extended Terminal/Extended Terminal.app/Contents/Resources/extended-terminal.zsh'
fi
# END Extended Terminal
ZSH_BLOCK
fi
SHELL_SETUP
if ! /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open -n '/Library/Application Support/Extended Terminal/Extended Terminal.app' --args --background --apply-theme; then
    /usr/bin/logger -t ExtendedTerminal 'Installed; launch Extended Terminal manually to finish setup.'
fi
old_bundle='/Applications/Extended Terminal.app'
if [ -f "$old_bundle/Contents/Info.plist" ]; then
    old_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$old_bundle/Contents/Info.plist" 2>/dev/null || true)
    if [ "$old_id" = 'dev.local.TerminalCopyOnSelect' ]; then
        /bin/rm -rf "$old_bundle"
    fi
fi
/bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open '/Library/PreferencePanes/Extended Terminal.prefPane' || true
exit 0
